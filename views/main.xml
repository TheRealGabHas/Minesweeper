<Window Width="1280" Height="720" Resizable="true" CustomHeader="true" Borderless="true" MinWidth="480" MinHeight="360">
	<VBox Spacing="10">
		<HeaderBar Title="Minesweeper" Enabled="true"/>
		<Border Padding="12" Material="Glass" Slot.Padding="16" BorderWidth="5" CornerRadius="09">
			<HBox Spacing="10">
				<Image Source="./minesweeper.png" Width="32" Height="32"/> <!-- Path is resolved from current XML filepath -->
				<Button Text="+ New game" Action="app.grid.generate"/>
				<Separator Orientation="Vertical"/>
				<Button Text="Grid Size" Action="app.grid.nextsize"/>
				<Label Text="Mine Density: 1" Name="mine-density-label" Slot.VAlign="Center"/>
				<Separator Orientation="Vertical"/>
				<Label Text="Mines remaining: 000" Name="mine-counter-label" Slot.VAlign="Center"/>
				<Separator Orientation="Vertical"/>
				<Label Text="Timer: 000" Name="timer-label" Slot.VAlign="Center"/>
			</HBox>
		</Border>
		<Separator Orientation="Horizontal" Slot.Padding="24,1,24,1"/>
		<VBox Spacing="10" Slot.Padding="16">
			<Grid Spacing="2" Name="minefield-grid" Columns="1" Rows="1">
				<!-- Grid element are dynamically added at runtime

				Position in the grid are defined by attributes
					<Button Slot.Column="0" Slot.Row="0" .../>
				Grid Size will be redefined from attributes too
					<Grid ... Columns="1,1,1..." Rows="1,1,1...">
				-->
			</Grid>
		</VBox>
	</VBox>
</Window>
